<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <Color x:Key="AppAccentColor">#22D3EE</Color>
    <Color x:Key="AppAccentDarkColor">#06B6D4</Color>
    <SolidColorBrush x:Key="AppAccentBrush" Color="{StaticResource AppAccentColor}" />
    <SolidColorBrush x:Key="AppAccentDarkBrush" Color="{StaticResource AppAccentDarkColor}" />
    <SolidColorBrush x:Key="AppSurfaceBrush" Color="#1E293B" />
    <SolidColorBrush x:Key="AppSurface2Brush" Color="#0F172A" />
    <SolidColorBrush x:Key="AppBorderBrush" Color="#334155" />
    <SolidColorBrush x:Key="AppMutedForegroundBrush" Color="#94A3B8" />
    <SolidColorBrush x:Key="AppErrorBrush" Color="#F87171" />

    <LinearGradientBrush x:Key="AppWindowBackgroundBrush" StartPoint="0%,0%" EndPoint="100%,100%">
      <GradientStop Color="#0B1220" Offset="0" />
      <GradientStop Color="#111827" Offset="0.5" />
      <GradientStop Color="#0F172A" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="TerminalBackgroundBrush" Color="#0D1117" />
    <SolidColorBrush x:Key="TerminalForegroundBrush" Color="#E6EDF3" />

    <BoxShadows x:Key="CardShadowSm">0 2 12 0 #30000000</BoxShadows>

    <Thickness x:Key="CardPadding">16</Thickness>
    <CornerRadius x:Key="CardCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="InputCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="ButtonCornerRadius">8</CornerRadius>
  </Styles.Resources>

  <Style Selector="Button.app-toolbar">
    <Setter Property="CornerRadius" Value="{StaticResource ButtonCornerRadius}" />
    <Setter Property="Padding" Value="14,10" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>

  <Style Selector="Button.app-primary">
    <Setter Property="CornerRadius" Value="{StaticResource ButtonCornerRadius}" />
    <Setter Property="Padding" Value="14,10" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Background" Value="{StaticResource AppAccentBrush}" />
    <Setter Property="Foreground" Value="#0F172A" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.app-primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AppAccentDarkBrush}" />
  </Style>
  <Style Selector="Button.app-primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#0E7490" />
  </Style>

  <Style Selector="Button.app-ghost">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
  </Style>
  <Style Selector="Button.app-ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#30FFFFFF" />
  </Style>

  <Style Selector="TextBlock.app-heading">
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="TextBlock.app-section">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource AppMutedForegroundBrush}" />
    <Setter Property="Margin" Value="0,0,0,10" />
  </Style>

  <Style Selector="Border.app-card">
    <Setter Property="Background" Value="{StaticResource AppSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
    <Setter Property="Padding" Value="{StaticResource CardPadding}" />
    <Setter Property="BoxShadow" Value="{StaticResource CardShadowSm}" />
  </Style>

  <Style Selector="ListBox.app-list">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="ListBox.app-list ListBoxItem">
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="Margin" Value="0,0,0,4" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="ListBox.app-list ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#25FFFFFF" />
    <Setter Property="BorderBrush" Value="{StaticResource AppAccentBrush}" />
    <Setter Property="BorderThickness" Value="2,0,0,0" />
  </Style>
  <Style Selector="ListBox.app-list ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#18FFFFFF" />
  </Style>

  <Style Selector="TabControl.app-tabs">
    <Setter Property="Margin" Value="0" />
  </Style>

  <Style Selector="TextBox.app-input">
    <Setter Property="CornerRadius" Value="{StaticResource InputCornerRadius}" />
  </Style>
</Styles>
